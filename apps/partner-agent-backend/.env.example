NODE_ENV=development
HOST=127.0.0.1
PORT=3000

AUTH_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081
ENABLE_LEGACY_AGENT_WS=false
MAX_SESSIONS_PER_USER=100

SESSION_STORE=postgres
DATABASE_URL=postgresql://partner_agent:change-me@localhost:5432/partner_agent
DATABASE_POOL_SIZE=10

CHAT_TASK_LEASE_MS=30000
CHAT_TASK_POLL_MS=1000
CHAT_TASK_WORKER_CONCURRENCY=4

WS_EVENT_RETENTION_COUNT=100
WS_EVENT_RETENTION_AGE_MS=86400000
WS_EVENT_RETENTION_BATCH_SIZE=500
WS_EVENT_RETENTION_INTERVAL_MS=60000

PRIVACY_DECISION_TTL_MS=900000
PRIVACY_DECISION_SCAN_INTERVAL_MS=5000
EGRESS_FINGERPRINT_MAX_BYTES=1048576
EGRESS_SENSITIVE_ACTION=redact
EGRESS_FORBIDDEN_CATEGORIES=

EXTERNAL_TOOL_APPROVAL_TTL_MS=600000
EXTERNAL_TOOL_UNDO_TTL_MS=600000

MODEL_GATEWAY_TIMEOUT_MS=60000
MODEL_GATEWAY_MAX_RETRIES=1
MODEL_GATEWAY_MAX_RETRY_DELAY_MS=2000

AGENT_RUN_TIMEOUT_MS=180000
AGENT_RUN_MAX_MODEL_TURNS=8
AGENT_RUN_MAX_TOOL_CALLS=12
AGENT_RUN_MAX_OUTPUT_TOKENS=16384
AGENT_RUN_MAX_REQUEST_TOKENS=4096

DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
